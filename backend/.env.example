# Copy to backend/.env and set a random SECRET_KEY (at least 32 characters).
APP_ENV=development
OTP_DEV_ENABLED=true
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/lanyenpharmacy
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SESSION_COOKIE_SECURE=false

# Set these server-side; never expose API_SECRET to clients.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SePay Gateway: Sandbox is the default. Never enable Production during tests.
# IPN: POST https://YOUR_BACKEND/api/payments/sepay/ipn, auth type SECRET_KEY.
# Submit the signed form returned by POST /api/orders/<id>/payment to Checkout.
SEPAY_ENV=sandbox
SEPAY_FRONTEND_ORIGIN=http://localhost:5500
# Set callback URLs below to https://YOUR_PUBLIC_BACKEND/api/payments/sepay/return
# for both environments. The backend appends the order ID; GET only redirects.
SEPAY_PRODUCTION_ENABLED=false
# Both payment environments use DATABASE_URL above. Never switch the database.
# Each new Gateway order stores its own immutable payment environment.
SEPAY_SANDBOX_MERCHANT_ID=
SEPAY_SANDBOX_SECRET_KEY=
SEPAY_SANDBOX_IPN_SECRET_KEY=
SEPAY_SANDBOX_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_SANDBOX_API_BASE_URL=https://pgapi-sandbox.sepay.vn
SEPAY_PRODUCTION_MERCHANT_ID=
SEPAY_PRODUCTION_SECRET_KEY=
SEPAY_PRODUCTION_IPN_SECRET_KEY=
SEPAY_PRODUCTION_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_PRODUCTION_API_BASE_URL=https://pgapi.sepay.vn
SEPAY_PRODUCTION_SUCCESS_URL=
SEPAY_PRODUCTION_ERROR_URL=
SEPAY_PRODUCTION_CANCEL_URL=
# Old Gateway group: fallback ONLY for Sandbox when its new credential group
# is entirely empty. Never fill a partially configured group from these values.
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_API_BASE_URL=https://pgapi-sandbox.sepay.vn
# Optional public HTTPS frontend return URLs. Redirects never confirm payment.
SEPAY_SUCCESS_URL=
SEPAY_ERROR_URL=
SEPAY_CANCEL_URL=

# Legacy bank QR/webhook compatibility for existing orders. Keep until retired.
# QR images do not require your SePay REST API token.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
