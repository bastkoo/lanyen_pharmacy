# Copy to backend/.env and set a random SECRET_KEY (at least 32 characters).
APP_ENV=development
OTP_DEV_ENABLED=true
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/lanyenpharmacy
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SESSION_COOKIE_SECURE=false
